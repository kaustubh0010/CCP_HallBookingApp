<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:paddingHorizontal="15dp"
    android:gravity="center"
    android:layout_height="match_parent"
    android:background="@color/white">


    <TextView
        android:id="@+id/textViewTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="0dp"
        android:fontFamily="@font/plusjakartasansbold"
        android:gravity="center"
        android:text="Sign in"
        android:textColor="@color/Blue6"
        android:textSize="42dp" />

    <TextView
        android:id="@+id/textViewInstruction"
        android:layout_below="@id/textViewTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:fontFamily="@font/plusjakartasansbold"
        android:gravity="center"
        android:text="Please log in to your account"
        android:textColor="@color/black"
        android:textSize="16dp" />

    <EditText
        android:id="@+id/email"
        android:layout_below="@id/textViewInstruction"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="60dp"
        android:padding="10dp"
        android:layout_centerHorizontal="true"
        android:inputType="textEmailAddress"
        android:fontFamily="@font/plusjakartasansmedium"
        android:background="@drawable/rounded_white_bg"
        android:hint=" Email" />


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_below="@id/email"
        android:id="@+id/layout11"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/pass"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_centerHorizontal="true"
            android:padding="10dp"
            android:inputType="textPassword"
            android:background="@drawable/rounded_white_bg"
            android:fontFamily="@font/plusjakartasansmedium"
            android:hint=" Password" />

        <ImageButton
            android:id="@+id/viewPassBtn"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="@color/off_white"
            android:layout_alignRight="@id/pass"
            android:layout_centerVertical="true"
            android:scaleType="centerInside"
            android:src="@drawable/eye"
            android:layout_marginRight="10dp"/> <!-- Moves the button 10dp to the left -->
    </RelativeLayout>


    <Button
        android:id="@+id/loginBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:paddingHorizontal="30dp"
        android:paddingBottom="5dp"
        android:layout_below="@id/layout11"
        android:layout_marginTop="20dp"
        android:background="@drawable/rounded_corner"
        android:backgroundTint="@color/Blue6"
        android:textColor="@color/white"
        android:fontFamily="@font/plusjakartasansbold"
        android:text="Sign in"
        android:textSize="20dp"
        android:textAllCaps="false"
        app:cornerRadius="8dp" />


    <RelativeLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/loginBtn">

        <TextView
            android:id="@+id/textViewGoToRegister"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginTop="30dp"
            android:fontFamily="@font/plusjakartasanssemibold"
            android:text="New here?"
            android:textSize="16dp" />

        <TextView
            android:id="@+id/gotoToRegPage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/textViewGoToRegister"
            android:layout_marginStart="5dp"
            android:layout_alignBaseline="@id/textViewGoToRegister"
            android:fontFamily="@font/plusjakartasanssemibold"
            android:text="@string/regLink"
            android:textSize="16dp" />

    </RelativeLayout>



</RelativeLayout>