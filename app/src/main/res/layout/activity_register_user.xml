<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:gravity="center"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ScrollView
        android:layout_width="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:paddingBottom="30dp"
            android:paddingHorizontal="15dp"
            android:layout_height="match_parent">

    <TextView
        android:id="@+id/textViewTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="5dp"
        android:fontFamily="@font/plusjakartasansbold"
        android:gravity="center"
        android:text="Sign Up"
        android:textColor="@color/Blue6"
        android:textSize="42dp" />

    <TextView
        android:id="@+id/textViewRegInstruction"
        android:layout_below="@id/textViewTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:fontFamily="@font/plusjakartasansbold"
        android:gravity="center"
        android:text="Please create a new account"
        android:textColor="@color/black"
        android:textSize="16dp" />

    <EditText
        android:id="@+id/editTextTextEmailAddress2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:ems="10"
        android:hint=" Email"
        android:inputType="textEmailAddress"
        android:fontFamily="@font/plusjakartasansmedium"
        android:background="@drawable/rounded_white_bg"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/textViewRegInstruction"
        android:layout_marginTop="40dp"/>

    <EditText
        android:id="@+id/editTextTextName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_white_bg"
        android:ems="10"
        android:hint=" Name"
        android:padding="10dp"
        android:inputType="textPersonName"
        android:fontFamily="@font/plusjakartasansmedium"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/editTextTextEmailAddress2"
        android:layout_marginTop="20dp"/>

    <EditText
        android:id="@+id/editTextTextDept"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_white_bg"
        android:ems="10"
        android:hint=" Department name"
        android:padding="10dp"
        android:fontFamily="@font/plusjakartasansmedium"
        android:inputType="textPersonName"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/editTextTextName"
        android:layout_marginTop="20dp"/>

    <EditText
        android:id="@+id/editTextTextPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_white_bg"
        android:ems="10"
        android:hint=" Contact"
        android:padding="10dp"
        android:inputType="phone"
        android:fontFamily="@font/plusjakartasansmedium"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/editTextTextDept"
        android:layout_marginTop="20dp"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_below="@id/editTextTextPhone"
                android:id="@+id/layout11"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="20dp"
                android:layout_height="wrap_content">
                <EditText
                    android:id="@+id/editTextTextPassword"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:background="@drawable/rounded_white_bg"
                    android:ems="10"
                    android:padding="10dp"
                    android:fontFamily="@font/plusjakartasansmedium"
                    android:hint=" Password"
                    android:inputType="textPassword"
                    />

                <ImageButton
                    android:id="@+id/imageButtonTogglePassword"
                    android:layout_width="45dp"
                    android:layout_height="44dp"
                    android:background="@color/off_white"
                    android:scaleType="centerInside"
                    android:src="@drawable/eye"
                    android:layout_alignParentRight="true"
                    android:layout_marginRight="10dp"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:id="@+id/layout22"
                android:layout_centerHorizontal="true"
                android:layout_below="@id/layout11"
                android:layout_marginTop="20dp"
                android:layout_height="wrap_content">
                <EditText
                    android:id="@+id/editTextTextConfirmPassword"
                    android:layout_width="match_parent"
                    android:padding="10dp"
                    android:layout_height="55dp"
                    android:background="@drawable/rounded_white_bg"
                    android:ems="10"
                    android:hint=" Confirm password"
                    android:fontFamily="@font/plusjakartasansmedium"
                    android:inputType="textPassword"
                    android:layout_centerHorizontal="true" />

                <ImageButton
                    android:id="@+id/imageButtonTogglePassword2"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:background="@color/off_white"
                    android:scaleType="centerInside"
                    android:src="@drawable/eye"
                    android:layout_centerVertical="true"
                    android:layout_alignParentRight="true"
                    android:layout_marginRight="10dp"/>
            </RelativeLayout>

    <Button
        android:id="@+id/RegisterButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/Blue6"
        android:textColor="@color/white"
        android:fontFamily="@font/plusjakartasansbold"
        android:background="@drawable/rounded_corner"
        android:text="Sign Up"
        android:textSize="20dp"
        app:cornerRadius="10dp"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/layout22"
        android:layout_marginTop="20dp"
        android:paddingBottom="5dp"
        android:textAllCaps="false"/>



    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:layout_marginTop="15dp"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/RegisterButton"
        android:gravity="center"
        android:id="@+id/bt_layout1">
        <TextView
            android:id="@+id/textViewGoToRegister"
            android:layout_width="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plusjakartasanssemibold"
            android:text=" Already have an account?"
            android:textSize="16dp" />

        <TextView
            android:id="@+id/gotoLoginBtn"
            android:layout_centerHorizontal="true"
            android:layout_below="@+id/textViewGoToRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plusjakartasanssemibold"
            android:text="@string/logLink"
            android:textSize="16dp" />
    </RelativeLayout>



        </RelativeLayout>
    </ScrollView>
</RelativeLayout>